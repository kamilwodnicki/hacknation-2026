# --- LLM ---
# none   = tylko reguły (bez AI)
# openai = API zgodne z OpenAI — domyślnie Mistral AI, endpoint UE (zalecane)
# vertex = Google Cloud Vertex AI, model Mistral Small 3.1 (Apache 2.0), region w UE
LLM_PROVIDER=none
LLM_TIMEOUT=120
# rules = tylko reguły; llm = cały JSON od modelu; hybrid = reguły + AI (zalecane, gdy jest klucz)
EXTRACTION_MODE=hybrid

# Mistral AI (gdy LLM_PROVIDER=openai): klucz z https://console.mistral.ai
LLM_API_BASE_URL=https://api.eu.mistral.ai/v1
LLM_API_KEY=WKLEJ_TUTAJ_KLUCZ_MISTRAL
LLM_MODEL_NAME=ministral-14b-2512

# Vertex AI: plik klucza konta usługi (NIE commitować — folder secrets/ jest ignorowany)
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/vertex-sa.json
# ID projektu — puste = odczytywane z pliku klucza
VERTEX_PROJECT=
VERTEX_REGION=europe-west4
VERTEX_PUBLISHER=mistralai
VERTEX_MODEL=mistral-small-2503

# --- Aplikacja ---
LOG_LEVEL=INFO
INPUT_DIR=/app/input
OUTPUT_DIR=/app/output
CONFIG_DIR=/app/config
API_PORT=8000
UI_PORT=8501
# Adres API widziany z kontenera UI
API_URL=http://api:8000

# --- OCR ---
# Rozdzielczość renderowania skanów do OCR
OCR_DPI=200
# Strona z mniejszą liczbą znaków alfanumerycznych w warstwie tekstowej = skan
OCR_MIN_TEXT_CHARS=30
# Limit stron OCR na dokument (0 = bez limitu)
OCR_MAX_PAGES=0

# --- Dane organizatora (tylko do testów/ewaluacji, montowane read-only w /data) ---
UZP_DATA_DIR=../DaneUrzedu/hacknation-2026
